{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "site", "dev"],
      "port": 3000
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "site", "start", "--port", "3002"],
      "port": 3002
    },
    {
      "name": "data",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "data", "dev"],
      "port": 3001
    },
    {
      "name": "data-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "data", "exec", "next", "start", "--port", "3003"],
      "port": 3003
    }
  ]
}
