# URL du site institutionnel (production : https://scd-rdc.org)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse du site qui fournit les fiches projets validées (facultatif : par défaut NEXT_PUBLIC_SITE_URL).
# SITE_API_URL=https://scd-rdc.org

# Données d'illustration (projets FICTIFS, signalés comme tels) : affichées automatiquement tant
# qu'aucune fiche n'est validée. DATA_ILLUSTRATION=0 les coupe (en ligne comme en local).
# DATA_ILLUSTRATION=0
# Forcer l'illustration sur votre ordinateur même si des fiches existent (ignoré sur Vercel) :
# DATA_DEMO=1
