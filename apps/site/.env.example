# ── Base de données PostgreSQL ─────────────────────────────────────────────
# Local : lancer `pnpm db:up` à la racine. Production : URL Neon (avec ?sslmode=require).
DATABASE_URL=postgres://scd:scd_dev@127.0.0.1:5433/scd_site

# Chaîne aléatoire longue et secrète (ex. : openssl rand -hex 32). Différente en production.
PAYLOAD_SECRET=a-remplacer

# URL publique du site (production : https://scd-rdc.org)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Adresse de SCD-RDC DATA (production : https://data.scd-rdc.org)
NEXT_PUBLIC_DATA_URL=http://localhost:3001

# Stockage des fichiers envoyés (photos, PDF) — production uniquement.
# Fourni automatiquement par Vercel quand un store Blob est relié au projet.
# Laisser vide en local : les fichiers sont alors enregistrés sur le disque.
BLOB_READ_WRITE_TOKEN=

# Envoi des e-mails des formulaires (Resend) — production.
# Sans clé, les e-mails sont seulement écrits dans la console (développement local).
RESEND_API_KEY=
# Adresse d'expédition : doit appartenir au domaine vérifié dans Resend (scd-rdc.org)
EMAIL_FROM_ADDRESS=noreply@scd-rdc.org
EMAIL_FROM_NAME=SCD-RDC
